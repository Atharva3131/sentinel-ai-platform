# Application
SENTINEL_APP_NAME=sentinel-ai-platform
SENTINEL_ENVIRONMENT=development
SENTINEL_DEBUG=true
SENTINEL_API_PREFIX=/api/v1
SENTINEL_SECRETS_DIR=/run/secrets

# Server
SENTINEL_SERVER__HOST=0.0.0.0
SENTINEL_SERVER__PORT=8000
SENTINEL_SERVER__WORKERS=1

# Logging
SENTINEL_LOGGING__LEVEL=DEBUG
SENTINEL_LOGGING__JSON_OUTPUT=false

# OpenTelemetry
SENTINEL_OPENTELEMETRY__ENABLED=true
SENTINEL_OPENTELEMETRY__OTLP_HTTP_ENDPOINT=
SENTINEL_OPENTELEMETRY__OTLP_HEADERS=
SENTINEL_OPENTELEMETRY__TRACE_SAMPLE_RATIO=1.0
SENTINEL_OPENTELEMETRY__EXPORT_TIMEOUT_SECONDS=10

# Azure credentials
SENTINEL_AZURE__AUTHENTICATION_MODE=default
SENTINEL_AZURE__TENANT_ID=
SENTINEL_AZURE__CLIENT_ID=
SENTINEL_AZURE__CLIENT_SECRET=
SENTINEL_AZURE__MANAGED_IDENTITY_CLIENT_ID=

# PostgreSQL
SENTINEL_POSTGRES__HOST=localhost
SENTINEL_POSTGRES__PORT=5432
SENTINEL_POSTGRES__DATABASE=sentinel
SENTINEL_POSTGRES__USERNAME=sentinel
SENTINEL_POSTGRES__PASSWORD=change-me
SENTINEL_POSTGRES__URL=
SENTINEL_POSTGRES__POOL_SIZE=10
SENTINEL_POSTGRES__MAX_OVERFLOW=20

# Redis
SENTINEL_REDIS__HOST=localhost
SENTINEL_REDIS__PORT=6379
SENTINEL_REDIS__DATABASE=0
SENTINEL_REDIS__USERNAME=
SENTINEL_REDIS__PASSWORD=
SENTINEL_REDIS__SSL=false
SENTINEL_REDIS__URL=

# Neo4j
SENTINEL_NEO4J__ENABLED=false
SENTINEL_NEO4J__SCHEME=neo4j
SENTINEL_NEO4J__HOST=localhost
SENTINEL_NEO4J__PORT=7687
SENTINEL_NEO4J__DATABASE=neo4j
SENTINEL_NEO4J__USERNAME=neo4j
SENTINEL_NEO4J__PASSWORD=change-me
SENTINEL_NEO4J__URI=

# Cosmos DB (use either a connection string or endpoint + managed identity)
SENTINEL_COSMOS__ENABLED=false
SENTINEL_COSMOS__CONNECTION_STRING=
SENTINEL_COSMOS__ENDPOINT=
SENTINEL_COSMOS__DATABASE_NAME=sentinel
SENTINEL_COSMOS__PREFERRED_LOCATIONS=["Central India","East US"]

# Blob Storage (use either a connection string or account URL + managed identity)
SENTINEL_BLOB__ENABLED=false
SENTINEL_BLOB__CONNECTION_STRING=
SENTINEL_BLOB__ACCOUNT_URL=
SENTINEL_BLOB__CONTAINER_NAME=sentinel

# Feature flags
SENTINEL_FEATURE_FLAGS__RUNTIME_ABSTRACTION=true
SENTINEL_FEATURE_FLAGS__GRAPH_RAG=false
SENTINEL_FEATURE_FLAGS__EVALUATION_PIPELINE=false
SENTINEL_FEATURE_FLAGS__RECOVERY_ENGINE=false
SENTINEL_FEATURE_FLAGS__NOTIFICATION_DELIVERY=false
SENTINEL_FEATURE_FLAGS__AUDIT_TRAIL=true
